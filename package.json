{
  "name": "qzyrium-clash",
  "productName": "Qzyrium-clash",
  "version": "0.2.1",
  "description": "Qzyrium-clash",
  "main": "./out/main/index.js",
  "author": "MISQZY",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint . --max-warnings=0",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "node scripts/verify-release.cjs resources && electron-vite build && electron-builder --publish never --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:ui": "electron scripts/verify-ui.cjs",
    "test:display:ui": "electron scripts/verify-display-ui.cjs",
    "test:editors:ui": "electron scripts/verify-editors-ui.cjs",
    "test:profiles:ui": "electron scripts/verify-profile-info-ui.cjs",
    "test:shortcuts:ui": "electron scripts/verify-shortcuts-ui.cjs",
    "test:startup:ui": "electron scripts/verify-startup-theme-ui.cjs",
    "test:proxies:offline": "node scripts/verify-offline-proxies.cjs",
    "test:proxies:offline:ui": "electron scripts/verify-offline-proxies-ui.cjs",
    "test:proxies:order:ui": "electron scripts/verify-proxy-order-ui.cjs",
    "test:updates": "node scripts/verify-updates.cjs",
    "test:updates:ui": "electron scripts/verify-updater-ui.cjs",
    "test:i18n": "node scripts/verify-i18n.cjs",
    "test:i18n:ui": "electron scripts/verify-localization-ui.cjs",
    "test:kernel": "node scripts/verify-kernel-lifecycle.cjs",
    "test:logs": "node scripts/verify-logs.cjs",
    "test:profiles": "node scripts/verify-profile-loading.cjs",
    "test:loading": "node scripts/verify-data-loading.cjs",
    "test:connections": "node scripts/verify-connections.cjs",
    "test:ipc": "node scripts/verify-ipc.cjs",
    "test:subscriptions": "node scripts/verify-subscriptions.cjs",
    "test:ipc:ui": "electron scripts/verify-ipc-ui.cjs",
    "test:subscriptions:ui": "electron scripts/verify-subscriptions-ui.cjs",
    "test:rules:ui": "electron scripts/verify-rules-ui.cjs",
    "test:rules": "node scripts/verify-rule-recovery.cjs",
    "test:rules:recovery:ui": "electron scripts/verify-rule-recovery-ui.cjs",
    "test:settings": "node scripts/verify-settings.cjs",
    "test:themes": "node scripts/verify-themes.cjs",
    "test:themes:ui": "electron scripts/verify-theme-contrast-ui.cjs",
    "test:geo": "node scripts/verify-globe.cjs",
    "test:geo:layout": "node scripts/verify-globe-layout.cjs",
    "test:geo:ui": "electron scripts/verify-globe-ui.cjs",
    "test:tray": "electron scripts/verify-tray.cjs",
    "test:recovery": "node scripts/verify-recovery.cjs",
    "test:functional": "node scripts/verify-functional.cjs",
    "test:runner": "node scripts/verify-test-runner.cjs",
    "test:all": "pnpm build && node scripts/test-runner.cjs",
    "test:ui:all": "node scripts/verify-ui-suite.cjs",
    "test:bundle": "node scripts/verify-bundle.cjs",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "prepare:icons": "electron scripts/prepare-app-icon.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.8.1",
    "electron-updater": "^6.8.11",
    "ws": "^8.18.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "electron": "^44.9.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^0.475.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
