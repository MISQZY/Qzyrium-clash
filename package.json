{
  "name": "qzyrium-vpn",
  "version": "0.1.0",
  "description": "Extensible Electron VPN and proxy client powered by Mihomo core",
  "main": "./out/main/index.js",
  "author": "MISQZY",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint . --max-warnings=0",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --publish never --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:ui": "electron scripts/verify-ui.cjs",
    "test:editors:ui": "electron scripts/verify-editors-ui.cjs",
    "test:updates": "node scripts/verify-updates.cjs",
    "test:updates:ui": "electron scripts/verify-updater-ui.cjs",
    "test:i18n": "node scripts/verify-i18n.cjs",
    "test:i18n:ui": "electron scripts/verify-localization-ui.cjs",
    "test:kernel": "node scripts/verify-kernel-lifecycle.cjs",
    "test:profiles": "node scripts/verify-profile-loading.cjs",
    "test:loading": "node scripts/verify-data-loading.cjs",
    "test:settings": "node scripts/verify-settings.cjs",
    "test:themes": "node scripts/verify-themes.cjs",
    "test:geo": "node scripts/verify-globe.cjs",
    "test:geo:layout": "node scripts/verify-globe-layout.cjs",
    "test:tray": "electron scripts/verify-tray.cjs",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "prepare:icons": "electron scripts/prepare-app-icon.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.49.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.8.1",
    "class-variance-authority": "^0.7.1",
    "cobe": "2.0.1",
    "electron-updater": "^6.8.11",
    "monaco-editor": "^0.57.0",
    "radix-ui": "^1.8.1",
    "ws": "^8.18.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
